--
-- Name: update_leaderboard(); Type: PROCEDURE; Schema: public; Owner: admin
--

CREATE PROCEDURE public.update_leaderboard()
    LANGUAGE plpgsql
    AS $$
BEGIN
    UPDATE leaderboard AS l
    SET rank = subquery.rank
    FROM (SELECT player_id, total_earning, RANK() OVER (ORDER BY total_earning DESC) AS rank
          FROM stats) AS subquery
    WHERE l.player_id = subquery.player_id;

    RAISE NOTICE 'Leaderboard was updated at %', NOW(); -- Raise error message with current timestamp

END;
$$;


ALTER PROCEDURE public.update_leaderboard() OWNER TO admin;

--
-- Name: update_net(integer); Type: PROCEDURE; Schema: public; Owner: admin
--

CREATE PROCEDURE public.update_net(count integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    i                  INT;
    current_price      DECIMAL(30, 0);
    current_cooldown   FLOAT;
    current_catch_coef FLOAT;
BEGIN
    FOR i IN 0..count
        LOOP
            current_price := 600 * (1.15) ^ (i - 9) * 3;
            current_cooldown := 300;
            current_catch_coef := 10 + i;

            UPDATE net
            set cooldown = current_cooldown
            where level = i;
        END LOOP;
END;
$$;


ALTER PROCEDURE public.update_net(count integer) OWNER TO admin;

