--
-- Name: calc_level_hardness(integer); Type: PROCEDURE; Schema: public; Owner: admin
--

CREATE PROCEDURE public.calc_level_hardness(count integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    i               INT;
    rod_price       DECIMAL(30, 0);
    net_price       DECIMAL(30, 0);
    rod_cooldown    FLOAT;
    net_cooldown    FLOAT;
    net_catch_coef  FLOAT;
    avg_catch       INT;
    total_rod_cost  FLOAT := 0; -- Initialize to 0
    total_rod_exp   FLOAT := 0; -- Initialize to 0
    total_net_cost  FLOAT := 0; -- Initialize to 0
    total_net_exp   FLOAT := 0; -- Initialize to 0
    avg_rod_cost    FLOAT;
    avg_rod_exp     FLOAT;
    avg_net_cost    FLOAT;
    avg_net_exp     FLOAT;
    cost_per_second FLOAT;
    exp_per_second  FLOAT;
    fish_data       fish_data_type[]; -- Declare as an array of records
    cur_fish_data   fish_data_type;
    cur_cost        FLOAT;
    cur_exp         FLOAT;
    exp_to_unlock   FLOAT;
    new_level_time  FLOAT;
    rod_time_to_buy FLOAT;
    net_time_to_buy FLOAT;
BEGIN
    TRUNCATE level_hardness;
    TRUNCATE levels;

    FOR i IN 1..count
        LOOP
            rod_price := 20 * (1.15) ^ (i - 1);
            rod_cooldown := 5 * (0.97) ^ i; -- Adjusted the exponent
            net_price := 150 * (1.15) ^ (i - 9) * 3;
            net_cooldown := 100;
            net_catch_coef := 1 + i * 0.1;

            avg_catch := 5 + i - 1;

            SELECT ARRAY_AGG(ROW (fish.fish_name, fish_chances.catch_chance))
            INTO fish_data
            FROM fish_chances
                     JOIN net ON net.level = fish_chances.net_level
                     JOIN fish ON fish_chances.fish_name = fish.fish_name
            WHERE net.level = i;

            total_rod_cost := 0;
            total_rod_exp := 0;
            total_net_cost := 0;
            total_net_exp := 0;

            FOREACH cur_fish_data IN ARRAY fish_data
                LOOP
                    SELECT cost, experience
                    INTO cur_cost, cur_exp
                    FROM fish
                    WHERE fish_name = cur_fish_data.fish_name;

                    total_rod_cost := total_rod_cost + cur_cost * avg_catch * cur_fish_data.catch_chance;
                    total_rod_exp := total_rod_exp + cur_exp * avg_catch * cur_fish_data.catch_chance;
                    total_net_cost :=
                                total_net_cost + cur_cost * avg_catch * cur_fish_data.catch_chance * net_catch_coef;
                    total_net_exp := total_net_exp + cur_exp * avg_catch * cur_fish_data.catch_chance * net_catch_coef;
                END LOOP;

            avg_rod_cost := total_rod_cost / rod_cooldown;
            avg_rod_exp := total_rod_exp / rod_cooldown;
            avg_net_cost := total_net_cost / net_cooldown;
            avg_net_exp := total_net_exp / net_cooldown;
            cost_per_second := avg_rod_cost + avg_net_cost;
            exp_per_second := avg_rod_exp + avg_net_exp;

            new_level_time := 20 * 1.05 ^ (i - 1);
            exp_to_unlock = new_level_time * exp_per_second;

            rod_time_to_buy = rod_price / cost_per_second;
            net_time_to_buy = net_price / cost_per_second;


            INSERT INTO level_hardness
            VALUES (i, rod_price, rod_time_to_buy, rod_cooldown, net_price, net_time_to_buy, net_cooldown,
                    net_catch_coef, avg_rod_cost, avg_rod_exp,
                    avg_net_cost, avg_net_exp, cost_per_second, exp_per_second, exp_to_unlock, new_level_time);

            INSERT INTO levels VALUES (i, exp_to_unlock);
        END LOOP;

END;
$$;


ALTER PROCEDURE public.calc_level_hardness(count integer) OWNER TO admin;

--
-- Name: delete_player(); Type: FUNCTION; Schema: public; Owner: admin
--

CREATE FUNCTION public.delete_player() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    DELETE
    FROM leaderboard
    WHERE player_id = OLD.player_id;


    DELETE
    FROM last_usages
    WHERE player_id = old.player_id;

    DELETE
    FROM fish_caught
    WHERE stats_id IN (SELECT id FROM stats WHERE player_id = OLD.player_id);

    DELETE
    FROM stats
    WHERE player_id = OLD.player_id;

    DELETE
    FROM fish_stored
    WHERE storage_id IN (SELECT id FROM storage WHERE player_id = OLD.player_id);

    DELETE
    FROM storage
    WHERE player_id = OLD.player_id;

    RETURN OLD;
END;
$$;


ALTER FUNCTION public.delete_player() OWNER TO admin;

--
-- Name: insert_fish_chances(integer); Type: PROCEDURE; Schema: public; Owner: admin
--

CREATE PROCEDURE public.insert_fish_chances(count integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    i INT;
    current_rod_level INT;
    current_net_level INT;
    cod_chance NUMERIC(4, 3);
    salmon_chance NUMERIC(4, 3);
    puffer_chance NUMERIC(4, 3);
BEGIN
    FOR i IN 0..count LOOP
        current_rod_level := i;
        current_net_level := i;

        IF i <= 5 THEN
            cod_chance := 1.0;
            salmon_chance := 0.0;
            puffer_chance := 0.0;
        ELSIF i <= 9 THEN
            cod_chance := GREATEST(0.0, 1.0 - 0.15 * (i - 5));
            salmon_chance := LEAST(1.0, 0.15 * (i - 5));
            puffer_chance := 0.0;
        ELSIF i = 10 THEN
            cod_chance := 0.20;
            salmon_chance := 0.75;
            puffer_chance := 0.05;
        ELSE
            cod_chance := GREATEST(0.0000, cod_chance * 0.8);
            salmon_chance := GREATEST(0.0000, salmon_chance * 0.9);
            puffer_chance := 1.0 - cod_chance - salmon_chance;
        END IF;

        INSERT INTO fish_chances (fish_name, rod_level, net_level, catch_chance)
        VALUES ('cod', current_rod_level, current_net_level, cod_chance),
               ('salmon', current_rod_level, current_net_level, salmon_chance),
               ('puffer', current_rod_level, current_net_level, puffer_chance);
    END LOOP;
END;
$$;


ALTER PROCEDURE public.insert_fish_chances(count integer) OWNER TO admin;

--
-- Name: insert_net(integer); Type: PROCEDURE; Schema: public; Owner: admin
--

CREATE PROCEDURE public.insert_net(count integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    i                  INT;
    current_price      DECIMAL(30, 0);
    current_cooldown   FLOAT;
    current_catch_coef FLOAT;
BEGIN
    FOR i IN 0..count
        LOOP
            current_price := 600 * (1.15) ^ (i - 9) * 3;
            current_cooldown := 300;
            current_catch_coef := 10 + i;

            INSERT INTO net (level, price, cooldown, catch_coef)
            VALUES (i, current_price, current_cooldown, current_catch_coef);
        END LOOP;
END;
$$;


ALTER PROCEDURE public.insert_net(count integer) OWNER TO admin;

--
-- Name: insert_player(); Type: FUNCTION; Schema: public; Owner: admin
--

CREATE FUNCTION public.insert_player() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    stats_id   INT;
    storage_id INT;
BEGIN
    INSERT INTO leaderboard(player_id, rank)
    VALUES (NEW.player_id, NULL);

    INSERT INTO last_usages(player_id, rod_last_use, net_last_use)
    VALUES (NEW.player_id, NULL, NULL);

    INSERT INTO stats(player_id, balance, total_earning)
    VALUES (NEW.player_id, 0, 0)
    RETURNING id INTO stats_id;

    INSERT INTO fish_caught(stats_id, fish_name, caught_amount)
    VALUES (stats_id, 'cod', 0),
           (stats_id, 'salmon', 0),
           (stats_id, 'puffer', 0);

    INSERT INTO storage(player_id)
    VALUES (NEW.player_id)
    RETURNING id INTO storage_id;

    INSERT INTO fish_stored(storage_id, fish_name, stored_amount)
    VALUES (storage_id, 'cod', 0),
           (storage_id, 'salmon', 0),
           (storage_id, 'puffer', 0);

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.insert_player() OWNER TO admin;

